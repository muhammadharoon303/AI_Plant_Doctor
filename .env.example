# AI Plant Doctor Environment Variables

# Project Settings
PROJECT_NAME="AI Plant Doctor"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# API Configuration
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Fallback to sqlite:///./plant_doctor.db if postgres is unavailable
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plant_doctor_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plant_doctor_db

# Storage Configuration
# Options: local, s3
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_STORAGE_BASE_URL=http://localhost:8000/uploads

# AWS S3 Storage (for Cloud-ready deployment)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-plant-doctor-bucket

# AI Model Configuration
MODEL_DIR=ai/weights
CLASSIFIER_MODEL_PATH=ai/weights/plant_classifier.pt
SEGMENTOR_MODEL_PATH=ai/weights/plant_segmentor.pt
INFERENCE_DEVICE=cpu # 'cpu' or 'cuda'

# Default Localization
DEFAULT_LANGUAGE=en
